<UserControl x:Class="Vega.UI.Views.PackageLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Grid Margin="10">


        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>





        <DockPanel Grid.Row="0"
                   Margin="0,0,0,10">


            <Button Content="+ Новый"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="NewPackage_Click"/>


            <Button Content="Изменить"
                    Width="110"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="EditPackage_Click"/>


            <Button Content="Удалить"
                    Width="100"
                    Height="35"
                    Margin="0,0,20,0"
                    Click="DeletePackage_Click"/>


            <TextBox Width="250"
                     Height="35"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText}"/>


        </DockPanel>






        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>









            <Border Grid.Column="0"
                    BorderThickness="1"
                    BorderBrush="Gray"
                    Margin="0,0,10,0">


                <TreeView ItemsSource="{Binding Categories}"
                          SelectedItemChanged="Category_Selected">

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>

                </TreeView>


            </Border>









            <ListBox Grid.Column="1"
                     ItemsSource="{Binding Packages}"
                     SelectedItem="{Binding SelectedPackage}"
                     MouseDoubleClick="PackageList_MouseDoubleClick">


                <ListBox.ItemTemplate>

                    <DataTemplate>


                        <StackPanel Margin="5">


                            <TextBlock Text="{Binding PackageName}"
                                       FontWeight="Bold"/>


                            <TextBlock Text="{Binding DisplayName}"/>


                        </StackPanel>


                    </DataTemplate>


                </ListBox.ItemTemplate>


            </ListBox>









            <Border Grid.Column="2"
                    Margin="20,0,0,0">


                <ScrollViewer>


                    <StackPanel>


                        <TextBlock Text="{Binding SelectedPackage.PackageName}"
                                   FontSize="24"
                                   FontWeight="Bold"/>



                        <TextBlock Text="{Binding SelectedPackage.DisplayName}"
                                   Margin="0,10,0,0"/>


                        <TextBlock Text="{Binding SelectedPackage.Category, StringFormat=Category: {0}}"
                                   Margin="0,5"/>


                        <TextBlock Text="{Binding SelectedPackage.Family, StringFormat=Family: {0}}"
                                   Margin="0,5"/>


                        <Separator Margin="0,15,0,10"/>



                        <TextBlock Text="Dimensions"
                                   FontWeight="Bold"
                                   FontSize="16"/>



                        <TextBlock Text="{Binding SelectedPackage.Length, StringFormat=Length: {0} mm}"
                                   Margin="0,5"/>


                        <TextBlock Text="{Binding SelectedPackage.Width, StringFormat=Width: {0} mm}"
                                   Margin="0,5"/>


                        <TextBlock Text="{Binding SelectedPackage.Height, StringFormat=Height: {0} mm}"
                                   Margin="0,5"/>





                        <Separator Margin="0,15,0,10"/>



                        <TextBlock Text="IPC"
                                   FontWeight="Bold"
                                   FontSize="16"/>



                        <TextBlock Text="{Binding SelectedPackage.IPCName}"
                                   Margin="0,5"/>





                        <Separator Margin="0,15,0,10"/>



                        <TextBlock Text="AOI Recommendations"
                                   FontWeight="Bold"
                                   FontSize="16"/>



                        <TextBlock Text="{Binding SelectedPackage.AOIRecommendations}"
                                   TextWrapping="Wrap"/>


                    </StackPanel>


                </ScrollViewer>


            </Border>


        </Grid>


    </Grid>


</UserControl>