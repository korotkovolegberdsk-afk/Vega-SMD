<UserControl x:Class="Vega.UI.Views.PackageLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>



        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <TextBox Grid.Row="0"
                     Margin="5"
                     Height="30"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>



            <ListBox Grid.Row="1"
                     Margin="5"
                     ItemsSource="{Binding Packages}"
                     SelectedItem="{Binding SelectedPackage}">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <StackPanel Margin="5">

                            <TextBlock Text="{Binding PackageName}"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding DisplayName}"/>

                        </StackPanel>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>


        </Grid>



        <ScrollViewer Grid.Column="1"
                      Margin="20">

            <StackPanel>

                <TextBlock Text="SMT Knowledge Base"
                           FontSize="24"
                           FontWeight="Bold"/>


                <Separator Margin="0,10"/>


                <TextBlock Text="Package:"
                           FontWeight="Bold"/>

                <TextBlock Text="{Binding SelectedPackage.PackageName}"/>


                <TextBlock Text="Name:"
                           Margin="0,10,0,0"
                           FontWeight="Bold"/>

                <TextBlock Text="{Binding SelectedPackage.DisplayName}"/>


                <TextBlock Text="Size:"
                           Margin="0,10,0,0"
                           FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="{Binding SelectedPackage.Length}"/>

                    <TextBlock Text=" x "/>

                    <TextBlock Text="{Binding SelectedPackage.Width}"/>

                    <TextBlock Text=" x "/>

                    <TextBlock Text="{Binding SelectedPackage.Height}"/>

                    <TextBlock Text=" mm"/>

                </StackPanel>


                <TextBlock Text="IPC:"
                           Margin="0,10,0,0"
                           FontWeight="Bold"/>

                <TextBlock Text="{Binding SelectedPackage.IPCName}"/>


                <TextBlock Text="AOI:"
                           Margin="0,10,0,0"
                           FontWeight="Bold"/>

                <TextBlock Text="{Binding SelectedPackage.AOIRecommendations}"
                           TextWrapping="Wrap"/>


            </StackPanel>

        </ScrollViewer>


    </Grid>

</UserControl>