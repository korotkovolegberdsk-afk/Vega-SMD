<Window x:Class="Vega.UI.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vega-SMD 0.1.0"
        Width="1600"
        Height="900"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл"/>
            <MenuItem Header="_Проект"/>
            <MenuItem Header="_Импорт"/>
            <MenuItem Header="_Библиотека"/>
            <MenuItem Header="_AOI"/>
            <MenuItem Header="_SPI"/>
            <MenuItem Header="_Трафарет"/>
            <MenuItem Header="_Справка"/>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="Готово"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="LightGray"
                    BorderThickness="0,0,1,0">

                <TreeView>
                    <TreeViewItem Header="Проект"/>
                </TreeView>

            </Border>

            <Border Grid.Column="1"
                    BorderBrush="LightGray"
                    BorderThickness="0,0,1,0">

                <Grid>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="24"
                               Foreground="Gray"
                               Text="Рабочая область"/>
                </Grid>

            </Border>

            <Border Grid.Column="2">

                <Grid>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Foreground="Gray"
                               Text="Свойства"/>
                </Grid>

            </Border>

        </Grid>

    </DockPanel>

</Window>