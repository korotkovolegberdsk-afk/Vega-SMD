<Window x:Class="Vega.UI.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Vega.UI.Views"
        Title="Vega-SMD 0.1.0"
        Width="1600"
        Height="900"
        WindowStartupLocation="CenterScreen">


    <DockPanel>


        <Menu DockPanel.Dock="Top">


            <MenuItem Header="File">

                <MenuItem Header="New Project"/>

                <MenuItem Header="Create Archive"
                          Click="CreateArchive_Click"/>

                <Separator/>

                <MenuItem Header="Exit"
                          Click="Exit_Click"/>

            </MenuItem>



            <MenuItem Header="Library">

                <MenuItem Header="Packages"/>

                <MenuItem Header="Add Package"
                          Click="AddPackage_Click"/>

                <MenuItem Header="Components"/>

                <MenuItem Header="Master Library">
                    <MenuItem Header="Components"
                              Click="OpenComponentLibrary_Click"/>
                </MenuItem>

            </MenuItem>



            <MenuItem Header="Import"/>

            <MenuItem Header="AOI"/>

            <MenuItem Header="SPI"/>

            <MenuItem Header="Stencil"/>


        </Menu>



        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <views:PackageLibraryView x:Name="PackageLibrary"/>


        </Grid>


    </DockPanel>


</Window>