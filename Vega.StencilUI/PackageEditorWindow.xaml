<Window x:Class="Vega.StencilUI.PackageEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Vega.StencilUI.Controls" Title="Редактор физического корпуса (Package)" Width="1280" Height="860" MinWidth="1050" MinHeight="700">
 <Window.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></Window.Resources>
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="{DynamicResource Save}" Width="96" Click="Save_Click"/><Button Content="{DynamicResource Cancel}" Width="96" Margin="8,0,0,0" Click="Cancel_Click"/></StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Foreground="IndianRed" Text="{Binding Errors[0]}" Margin="0,8,0,0"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43*"/><ColumnDefinition Width="57*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" BorderBrush="{DynamicResource GridBorderBrush}" BorderThickness="0,0,1,0" Padding="0,0,14,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="PARAMETERS" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
    <GroupBox Header="ОБЩИЕ СВЕДЕНИЯ КОРПУСА"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Имя корпуса (Package)"/><TextBox Grid.Column="1" Text="{Binding PackageName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="1" Text="Стандартное имя корпуса"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StandardName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="2" Text="Отображаемое имя корпуса"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="3" Text="Семейство корпуса"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Families}" SelectedItem="{Binding PackageFamily}"/><TextBlock Grid.Row="4" Text="Категория применения корпуса"/><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ComponentTypes}" SelectedItem="{Binding ComponentType}"/></Grid></GroupBox>
    <GroupBox Header="ГЕОМЕТРИЯ КОРПУСА" Margin="0,10,0,0"><StackPanel Margin="10"><TextBox Text="{Binding BodyLength,UpdateSourceTrigger=PropertyChanged,StringFormat=D {0:0.###} mm}" ToolTip="D — Body Length"/><TextBox Text="{Binding BodyWidth,UpdateSourceTrigger=PropertyChanged,StringFormat=E {0:0.###} mm}" ToolTip="E — Body Width"/><TextBox Text="{Binding Height,UpdateSourceTrigger=PropertyChanged,StringFormat=A {0:0.###} mm}" ToolTip="A — Height"/></StackPanel></GroupBox>
    <GroupBox Header="ВЫВОДЫ / ПЛОЩАДКИ" Margin="0,10,0,0" Visibility="{Binding ShowLeadFields,Converter={StaticResource VisibleWhenTrue}}"><StackPanel Margin="10"><TextBox Text="{Binding LeadCount,UpdateSourceTrigger=PropertyChanged,StringFormat=N {0}}"/><TextBox Text="{Binding PadCount,UpdateSourceTrigger=PropertyChanged,StringFormat=Pad Count {0}}"/><TextBox Text="{Binding Pitch,UpdateSourceTrigger=PropertyChanged,StringFormat=e {0:0.###} mm}"/><TextBox Text="{Binding LeadLength,UpdateSourceTrigger=PropertyChanged,StringFormat=L {0:0.###} mm}"/><TextBox Text="{Binding LeadWidth,UpdateSourceTrigger=PropertyChanged,StringFormat=b {0:0.###} mm}"/></StackPanel></GroupBox>
    <GroupBox Header="EXPOSED PAD" Margin="0,10,0,0" Visibility="{Binding ShowThermalFields,Converter={StaticResource VisibleWhenTrue}}"><StackPanel Margin="10"><TextBox Text="{Binding ThermalPadLength,UpdateSourceTrigger=PropertyChanged,StringFormat=D2 / EP-L {0:0.###} mm}"/><TextBox Text="{Binding ThermalPadWidth,UpdateSourceTrigger=PropertyChanged,StringFormat=E2 / EP-W {0:0.###} mm}"/></StackPanel></GroupBox>
    <GroupBox Header="BALL ARRAY" Margin="0,10,0,0" Visibility="{Binding ShowBallFields,Converter={StaticResource VisibleWhenTrue}}"><StackPanel Margin="10"><TextBox Text="{Binding PadCount,UpdateSourceTrigger=PropertyChanged,StringFormat=Ball Count {0}}"/><TextBox Text="{Binding BallPitch,UpdateSourceTrigger=PropertyChanged,StringFormat=e / BP {0:0.###} mm}"/><TextBox Text="{Binding BallDiameter,UpdateSourceTrigger=PropertyChanged,StringFormat=b / BD {0:0.###} mm}"/></StackPanel></GroupBox>
    <GroupBox Header="ОБОЗНАЧЕНИЯ / AOI" Margin="0,10,0,0"><StackPanel Margin="10"><TextBox Text="{Binding IPCName,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding JEDECName,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding YamahaName,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding MirtecAoiClass,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="45"/></StackPanel></GroupBox>
   </StackPanel></ScrollViewer></Border>
   <Grid Grid.Column="1" Margin="18,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions><StackPanel><TextBlock Text="ИНЖЕНЕРНЫЙ ЧЕРТЁЖ КОРПУСА" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding PackageFamily}" FontWeight="SemiBold"/><TextBlock Text="Размеры: мм" Opacity=".75"/></StackPanel><Border Grid.Row="1" MinHeight="450" Margin="0,10" BorderBrush="{DynamicResource GridBorderBrush}" BorderThickness="1"><controls:PackageDrawingPreview Package="{Binding PreviewPackage}" RefreshVersion="{Binding PreviewVersion}"/></Border><DataGrid Grid.Row="2" ItemsSource="{Binding Aliases}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Alias" Binding="{Binding Alias}"/><DataGridTextColumn Header="Type" Binding="{Binding AliasType}"/><DataGridTextColumn Header="Notes" Binding="{Binding Source}"/></DataGrid.Columns></DataGrid></Grid>
  </Grid>
 </DockPanel>
</Window>