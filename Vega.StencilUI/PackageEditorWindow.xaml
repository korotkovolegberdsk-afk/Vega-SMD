<Window x:Class="Vega.StencilUI.PackageEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Vega.StencilUI.Controls" Title="Package Editor" Width="1200" Height="820"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Save" Width="90" Click="Save_Click"/><Button Content="Cancel" Width="90" Margin="8,0,0,0" Click="Cancel_Click"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Foreground="IndianRed" Text="{Binding Errors[0]}" Margin="0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions><ScrollViewer><StackPanel><TextBlock Text="GENERAL" FontWeight="Bold"/><TextBox Text="{Binding PackageName,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding StandardName,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}"/><ComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding PackageFamily}"/><ComboBox ItemsSource="{Binding ComponentTypes}" SelectedItem="{Binding ComponentType}"/><TextBlock Text="BODY" FontWeight="Bold" Margin="0,10,0,0"/><WrapPanel><TextBox Width="90" Text="{Binding Length,UpdateSourceTrigger=PropertyChanged,StringFormat=F3}"/><TextBox Width="90" Text="{Binding Width,UpdateSourceTrigger=PropertyChanged,StringFormat=F3}"/><TextBox Width="90" Text="{Binding Height,UpdateSourceTrigger=PropertyChanged,StringFormat=F3}"/><TextBox Width="90" Text="{Binding BodyLength,UpdateSourceTrigger=PropertyChanged,StringFormat=F3}"/><TextBox Width="90" Text="{Binding BodyWidth,UpdateSourceTrigger=PropertyChanged,StringFormat=F3}"/></WrapPanel><TextBlock Text="LEADS / PADS" FontWeight="Bold" Margin="0,10,0,0"/><WrapPanel><TextBox Width="70" Text="{Binding LeadCount,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="70" Text="{Binding PadCount,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="90" Text="{Binding Pitch,UpdateSourceTrigger=PropertyChanged,StringFormat=F3}"/><TextBox Width="90" Text="{Binding LeadLength,UpdateSourceTrigger=PropertyChanged,StringFormat=F3}"/><TextBox Width="90" Text="{Binding LeadWidth,UpdateSourceTrigger=PropertyChanged,StringFormat=F3}"/></WrapPanel><TextBlock Text="THERMAL PAD / BGA" FontWeight="Bold" Margin="0,10,0,0"/><WrapPanel><TextBox Width="90" Text="{Binding ThermalPadLength,UpdateSourceTrigger=PropertyChanged,StringFormat=F3}"/><TextBox Width="90" Text="{Binding ThermalPadWidth,UpdateSourceTrigger=PropertyChanged,StringFormat=F3}"/><TextBox Width="90" Text="{Binding BallDiameter,UpdateSourceTrigger=PropertyChanged,StringFormat=F3}"/><TextBox Width="90" Text="{Binding BallPitch,UpdateSourceTrigger=PropertyChanged,StringFormat=F3}"/></WrapPanel><TextBlock Text="NAMING / AOI" FontWeight="Bold" Margin="0,10,0,0"/><TextBox Text="{Binding IPCName,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding JEDECName,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding YamahaName,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding MirtecAoiClass,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></ScrollViewer><DockPanel Grid.Column="1"><Border Height="300" BorderBrush="Gray" BorderThickness="1"><controls:PackageDrawingPreview Package="{Binding PreviewPackage}"/></Border><DataGrid DockPanel.Dock="Bottom" Height="220" ItemsSource="{Binding Aliases}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Alias" Binding="{Binding Alias}"/><DataGridTextColumn Header="Type" Binding="{Binding AliasType}"/><DataGridTextColumn Header="Notes" Binding="{Binding Source}"/></DataGrid.Columns></DataGrid></DockPanel></Grid></DockPanel></Window>