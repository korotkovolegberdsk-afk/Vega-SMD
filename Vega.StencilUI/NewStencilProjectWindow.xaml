<Window x:Class="Vega.StencilUI.NewStencilProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vega.StencilUI.ViewModels"
        Title="Новый проект трафарета" Width="620" Height="490" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Window.DataContext><vm:NewStencilProjectViewModel /></Window.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <TextBlock Grid.ColumnSpan="3" Text="Новый проект трафарета" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
        <TextBlock Grid.Row="1" Text="Название проекта" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="2" Text="Заказчик" VerticalAlignment="Center" Margin="0,12,0,0"/><TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Text="{Binding Customer, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="3" Text="Источник" VerticalAlignment="Top" Margin="0,16,0,0"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,16,0,0"><RadioButton Content="Paste Gerber" IsChecked="{Binding IsPasteGerber}"/><RadioButton Content="Altium PcbDoc" IsChecked="{Binding IsAltiumPcbDoc}" Margin="18,0,0,0"/><RadioButton Content="Panel Gerber" IsChecked="{Binding IsPanelGerber}" Margin="18,0,0,0"/></StackPanel>
        <TextBlock Grid.Row="4" Text="Сторона" VerticalAlignment="Center" Margin="0,12,0,0"/><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0"><RadioButton Content="TOP" IsChecked="{Binding IsTop}"/><RadioButton Content="BOTTOM" IsChecked="{Binding IsBottom}" Margin="18,0,0,0"/></StackPanel><TextBlock Grid.Row="4" Grid.Column="2" Text="Рамка" VerticalAlignment="Center" Margin="0,12,0,0"/>
        <ComboBox Grid.Row="4" Grid.Column="2" Margin="0,12,0,0" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}" DisplayMemberPath="Name" />
        <Grid Grid.Row="5" Grid.ColumnSpan="3" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
            <TextBlock Text="TOP Paste (.gtp)" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding TopPasteFile}"/><Button Grid.Column="2" Content="Выбрать" Click="BrowseTop_Click"/>
            <TextBlock Grid.Row="1" Text="BOTTOM Paste (.gbp)" VerticalAlignment="Center" Margin="0,8,0,0"/><TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding BottomPasteFile}"/><Button Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" Content="Выбрать" Click="BrowseBottom_Click"/>
            <TextBlock Grid.Row="2" Text="Assembly Drawing" VerticalAlignment="Center" Margin="0,8,0,0"/><TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="{Binding AssemblyDrawingFile}"/><Button Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" Content="Выбрать" Click="BrowseAssembly_Click"/>
        </Grid>
        <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Создать" Width="105" Click="Create_Click"/><Button Content="Отмена" Width="105" Click="Cancel_Click"/></StackPanel>
    </Grid>
</Window>