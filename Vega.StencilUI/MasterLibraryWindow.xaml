<Window x:Class="Vega.StencilUI.MasterLibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Vega.StencilUI.ViewModels" xmlns:controls="clr-namespace:Vega.StencilUI.Controls" Title="Vega-SMD Master Package Library" Width="1450" Height="900" MinWidth="1100" MinHeight="700">
 <Window.DataContext><vm:MasterLibraryViewModel/></Window.DataContext>
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Button Content="Add Package" Click="AddPackage_Click"/><Button Content="Edit Package" IsEnabled="{Binding HasSelectedPackage}" Margin="8,0,0,0" Click="EditPackage_Click"/><Button Content="Duplicate" IsEnabled="{Binding HasSelectedPackage}" Margin="8,0,0,0" Click="Duplicate_Click"/><Button Content="Delete" IsEnabled="{Binding HasSelectedPackage}" Margin="8,0,0,0" Click="Delete_Click"/></StackPanel><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="360"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Grid.Column="1" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="All Packages" Margin="10,0,0,0" Click="AllPackages_Click"/></Grid></StackPanel>
  <StatusBar DockPanel.Dock="Bottom"><TextBlock Text="{Binding StatusText}"/></StatusBar>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
   <Border BorderBrush="Gray" BorderThickness="1" Padding="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="PACKAGE FAMILIES" FontWeight="Bold" Margin="0,0,0,8"/><ListBox ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}"/></DockPanel></Border>
   <DataGrid Grid.Column="1" Margin="10,0" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns>
    <DataGridTextColumn Header="PackageName" Binding="{Binding PackageName}" Width="*"/><DataGridTextColumn Header="DisplayName" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Family" Binding="{Binding PackageFamily}" Width="90"/><DataGridTextColumn Header="ComponentType" Binding="{Binding ComponentType}" Width="100"/><DataGridTextColumn Header="LeadCount" Binding="{Binding LeadCount}" Width="70"/><DataGridTextColumn Header="Pitch" Binding="{Binding Pitch,StringFormat={}{0:F3} mm}" Width="95"/><DataGridTextColumn Header="BodyLength" Binding="{Binding BodyLength,StringFormat={}{0:F3} mm}" Width="105"/><DataGridTextColumn Header="BodyWidth" Binding="{Binding BodyWidth,StringFormat={}{0:F3} mm}" Width="105"/><DataGridTextColumn Header="Height" Binding="{Binding Height,StringFormat={}{0:F3} mm}" Width="95"/>
   </DataGrid.Columns></DataGrid>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="PROPERTIES" FontWeight="Bold"/><TextBlock Text="GENERAL" FontWeight="Bold" Margin="0,10,0,2"/><TextBlock Text="{Binding SelectedPackage.PackageName,StringFormat=Package Name: {0}}"/><TextBlock Text="{Binding SelectedPackage.StandardName,StringFormat=Standard Name: {0}}"/><TextBlock Text="{Binding SelectedPackage.DisplayName,StringFormat=Display Name: {0}}"/><TextBlock Text="{Binding SelectedPackage.PackageFamily,StringFormat=Family: {0}}"/><TextBlock Text="{Binding SelectedPackage.ComponentType,StringFormat=Component Type: {0}}"/><TextBlock Text="BODY" FontWeight="Bold" Margin="0,10,0,2"/><TextBlock Text="{Binding SelectedPackage.Length,StringFormat=Length: {0:F3} mm}"/><TextBlock Text="{Binding SelectedPackage.Width,StringFormat=Width: {0:F3} mm}"/><TextBlock Text="{Binding SelectedPackage.Height,StringFormat=Height: {0:F3} mm}"/><TextBlock Text="{Binding SelectedPackage.BodyLength,StringFormat=Body Length: {0:F3} mm}"/><TextBlock Text="{Binding SelectedPackage.BodyWidth,StringFormat=Body Width: {0:F3} mm}"/><TextBlock Text="LEADS" FontWeight="Bold" Margin="0,10,0,2"/><TextBlock Text="{Binding SelectedPackage.LeadCount,StringFormat=Lead Count: {0}}"/><TextBlock Text="{Binding SelectedPackage.PadCount,StringFormat=Pad Count: {0}}"/><TextBlock Text="{Binding SelectedPackage.Pitch,StringFormat=Pitch: {0:F3} mm}"/><TextBlock Text="{Binding SelectedPackage.LeadLength,StringFormat=Lead Length: {0:F3} mm}"/><TextBlock Text="{Binding SelectedPackage.LeadWidth,StringFormat=Lead Width: {0:F3} mm}"/><TextBlock Text="THERMAL PAD" FontWeight="Bold" Margin="0,10,0,2"/><TextBlock Text="{Binding SelectedPackage.ThermalPadLength,StringFormat=Length: {0:F3} mm}"/><TextBlock Text="{Binding SelectedPackage.ThermalPadWidth,StringFormat=Width: {0:F3} mm}"/><TextBlock Text="BGA" FontWeight="Bold" Margin="0,10,0,2"/><TextBlock Text="{Binding SelectedPackage.BallDiameter,StringFormat=Ball Diameter: {0:F3} mm}"/><TextBlock Text="{Binding SelectedPackage.BallPitch,StringFormat=Ball Pitch: {0:F3} mm}"/><TextBlock Text="NAMING" FontWeight="Bold" Margin="0,10,0,2"/><TextBlock Text="{Binding SelectedPackage.IPCName,StringFormat=IPC: {0}}"/><TextBlock Text="{Binding SelectedPackage.JEDECName,StringFormat=JEDEC: {0}}"/><TextBlock Text="{Binding SelectedPackage.YamahaName,StringFormat=Yamaha: {0}}"/><TextBlock Text="AOI" FontWeight="Bold" Margin="0,10,0,2"/><TextBlock Text="{Binding SelectedPackage.MirtecAoiClass,StringFormat=Mirtec: {0}}"/><TextBlock Text="ALIASES" FontWeight="Bold" Margin="0,10,0,2"/><ItemsControl ItemsSource="{Binding Aliases}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Alias}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="ENGINEERING DRAWING" FontWeight="Bold" Margin="0,10,0,2"/><Border Height="250" BorderBrush="Gray" BorderThickness="1"><controls:PackageDrawingPreview Package="{Binding SelectedPackage}"/></Border></StackPanel></ScrollViewer>
  </Grid>
 </DockPanel>
</Window>