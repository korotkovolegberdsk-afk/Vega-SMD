<Window x:Class="Vega.StencilUI.MasterLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vega.StencilUI.ViewModels"
        xmlns:components="clr-namespace:Vega.StencilUI.Components"
        Title="Библиотека корпусов и компонентов" Width="1700" Height="900" MinWidth="1300" MinHeight="700">
  <Window.DataContext><vm:MasterLibraryViewModel /></Window.DataContext>
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*"/>
      <ColumnDefinition Width="2*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" BorderBrush="{DynamicResource GridBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,10,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <WrapPanel>
            <Button Content="Добавить корпус" Click="AddPackage_Click" Margin="0,0,6,6"/>
            <Button Content="Изменить корпус" IsEnabled="{Binding HasSelectedPackage}" Click="EditPackage_Click" Margin="0,0,6,6"/>
            <Button Content="Создать копию" IsEnabled="{Binding HasSelectedPackage}" Click="Duplicate_Click" Margin="0,0,6,6"/>
            <Button Content="Удалить корпус" IsEnabled="{Binding HasSelectedPackage}" Click="Delete_Click" Margin="0,0,6,6"/>
            <Button Content="Импорт корпусов" Click="ImportPackages_Click" Margin="0,0,6,6"/>
            <Button Content="Экспорт шаблона" Click="ExportImportTemplate_Click" Margin="0,0,6,6"/>
          </WrapPanel>
          <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="2" Content="Все корпуса" Margin="8,0,0,0" Click="AllPackages_Click"/>
          </Grid>
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
        </StatusBar>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="155"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border BorderBrush="{DynamicResource GridBorderBrush}" BorderThickness="1" Padding="7" Margin="0,0,8,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="СЕМЕЙСТВА КОРПУСОВ" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <ListBox ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}"/>
            </DockPanel>
          </Border>
          <DataGrid Grid.Column="1" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}"
                    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    SelectionMode="Single" SelectionUnit="FullRow"
                    MouseDoubleClick="PackagesGrid_MouseDoubleClick" PreviewKeyDown="PackagesGrid_PreviewKeyDown">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Style.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2F80ED"/>
                    <Setter Property="Foreground" Value="White"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
              <Style TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2F80ED"/>
                    <Setter Property="Foreground" Value="White"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Корпус" Binding="{Binding PackageName}" Width="115"/>
              <DataGridTextColumn Header="Семейство" Binding="{Binding PackageFamily}" Width="85"/>
              <DataGridTextColumn Header="Тип" Binding="{Binding ComponentType}" Width="85"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </DockPanel>
    </Border>

    <components:ComponentCard Grid.Column="1"
                              Component="{Binding SelectedComponent}"
                              Package="{Binding SelectedPackage}"
                              Geometry="{Binding SelectedGeometry}"
                              TapeProfile="{Binding SelectedProfile}"
                              StencilRule="{Binding SelectedStencilRule}"
                              RelatedComponents="{Binding RelatedComponents}"/>
  </Grid>
</Window>
