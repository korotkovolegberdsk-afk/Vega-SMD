<Window x:Class="Vega.StencilUI.Views.Sot23ApertureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Апертуры трафарета — SOT23"
        Width="980" Height="640" MinWidth="820" MinHeight="520"
        Background="White" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="VegaBlue" Color="#1554D1" />
        <SolidColorBrush x:Key="LineBrush" Color="#B8C7DD" />
        <SolidColorBrush x:Key="BodyBrush" Color="#24272B" />
        <SolidColorBrush x:Key="LeadBrush" Color="#D9E0E8" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.35*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
            <TextBlock Text="SOT23" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource VegaBlue}" />
            <TextBlock Text="  АПЕРТУРЫ ТРАФАРЕТА" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource VegaBlue}" VerticalAlignment="Center" />
            <TextBlock Text="Vega-SMD" FontSize="20" FontStyle="Italic" FontWeight="SemiBold" Foreground="{StaticResource VegaBlue}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="1. РАСПОЛОЖЕНИЕ АПЕРТУР" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource VegaBlue}" />
                <Viewbox Grid.Row="1" Margin="30,12">
                    <Canvas Width="520" Height="350">
                        <Rectangle Canvas.Left="115" Canvas.Top="92" Width="290" Height="166" RadiusX="16" RadiusY="16" Fill="{StaticResource BodyBrush}" />
                        <Rectangle Canvas.Left="150" Canvas.Top="35" Width="42" Height="36" Fill="{StaticResource LeadBrush}" Stroke="#657384" />
                        <Rectangle Canvas.Left="328" Canvas.Top="35" Width="42" Height="36" Fill="{StaticResource LeadBrush}" Stroke="#657384" />
                        <Rectangle Canvas.Left="239" Canvas.Top="279" Width="42" Height="36" Fill="{StaticResource LeadBrush}" Stroke="#657384" />
                        <Ellipse Canvas.Left="138" Canvas.Top="115" Width="18" Height="18" Fill="White" Stroke="#9AA8BA" />
                        <TextBlock Canvas.Left="165" Canvas.Top="10" Text="3" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Canvas.Left="343" Canvas.Top="10" Text="2" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Canvas.Left="256" Canvas.Top="320" Text="1" FontSize="20" FontWeight="SemiBold" />
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Row="2" Text="Расположение выводов: 3–2 сверху, 1 снизу. Геометрия апертур строится по подтверждённой посадочной площадке." Foreground="#53657C" TextWrapping="Wrap" FontSize="13" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="14">
            <StackPanel>
                <TextBlock Text="2. РЕКОМЕНДАЦИИ" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource VegaBlue}" Margin="0,0,0,14" />
                <TextBlock Text="Правило апертур производителя отсутствует" FontSize="15" FontStyle="Italic" Foreground="#53657C" TextWrapping="Wrap" Margin="0,0,0,18" />
                <TextBlock Text="Рекомендации Vega-SMD" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                <TextBlock Text="• не уменьшать апертуру без подтверждённого правила;" TextWrapping="Wrap" Margin="0,3" />
                <TextBlock Text="• применять скругление углов апертуры;" TextWrapping="Wrap" Margin="0,3" />
                <TextBlock Text="• проверить соотношение площади и толщины трафарета;" TextWrapping="Wrap" Margin="0,3" />
                <TextBlock Text="• перед выпуском Gerber подтвердить размеры посадочных площадок." TextWrapping="Wrap" Margin="0,3" />
                <Border Background="#F2F5FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,22,0,0">
                    <TextBlock Text="Статус: требуется подтверждённое правило или посадочная площадка." Foreground="#53657C" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
