<UserControl x:Class="Vega.StencilUI.Views.EngineeringWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Vega.EngineeringDashboard.Models;assembly=Vega.EngineeringDashboard"
             Background="{DynamicResource WindowBackgroundBrush}">
    <UserControl.Resources>
        <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />            <Setter Property="Template" Value="{DynamicResource ThemedButtonControlTemplate}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridBorderBrush}" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridBorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridBorderBrush}" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridBorderBrush}" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource GridHeaderTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridBorderBrush}" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridBorderBrush}" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource PreviewBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridBorderBrush}" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridBorderBrush}" />            <Setter Property="Template" Value="{DynamicResource ThemedTabItemControlTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TabSelectedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PreviewTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PreviewTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridBorderBrush}" />            <Setter Property="Template" Value="{DynamicResource ThemedTabItemControlTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TabSelectedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PreviewTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}" BorderThickness="0" Padding="20,14">
<Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="185" Height="64" CornerRadius="6" BorderThickness="0" Padding="0" Background="{DynamicResource LogoSurfaceBrush}" BorderBrush="Transparent">
                    <Image Source="/Vega.StencilUI;component/Resources/Images/Vega-SMD-Logo.jpg"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{DynamicResource ConsoleTitle}"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="32,16,0,0"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
<ToolBar DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackgroundBrush}" Padding="8,6">
            <Button Content="{DynamicResource OpenProject}" Command="{Binding OpenProjectCommand}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}" Margin="0,0,10,0" Padding="12,7" />
            <Button Content="{DynamicResource AnalyzeStencil}" Command="{Binding AnalyzeStencilCommand}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}" Margin="0,0,10,0" Padding="12,7" />
            <Button Content="{DynamicResource TechnologyDecision}" Command="{Binding TechnologyDecisionCommand}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}" Margin="0,0,10,0" Padding="12,7" />
            <Button Content="{DynamicResource OpenPreview}" Command="{Binding PreviewCommand}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}" Margin="0,0,10,0" Padding="12,7" />
            <Button Content="{DynamicResource ExportReport}" Command="{Binding ExportReportCommand}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}" Margin="0,0,10,0" Padding="12,7" />
            <Button Content="{DynamicResource History}" Command="{Binding OpenHistoryCommand}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}" Margin="0" Padding="12,7" />
        </ToolBar>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBackgroundBrush}" BorderBrush="{DynamicResource StatusBorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Project}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ProjectName}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock><Run Text="{DynamicResource BoardRevisionLabel}"/><Run Text="{Binding BoardRevision, Mode=OneWay}"/><Run Text="    "/><Run Text="{DynamicResource CustomerLabel}"/><Run Text="{Binding Customer, Mode=OneWay}"/></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource StencilRevisionLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding StencilRevision}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stencil}" Style="{StaticResource SectionTitle}" />
                        <TextBlock><Run Text="{DynamicResource FrameLabel}"/><Run Text="{Binding Frame, Mode=OneWay}"/></TextBlock>
                        <TextBlock><Run Text="{DynamicResource ThicknessLabel}"/><Run Text="{Binding StencilThickness, Mode=OneWay, StringFormat={}{0:0.###} mm}"/></TextBlock>
                        <TextBlock><Run Text="{DynamicResource AperturesLabel}"/><Run Text="{Binding ApertureCount, Mode=OneWay}"/></TextBlock>
                        <TextBlock><Run Text="{DynamicResource ChangesLabel}"/><Run Text="{Binding ChangesCount, Mode=OneWay}"/></TextBlock>
                        <TextBlock Text="{Binding StencilRevision}" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Technology}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding TechnologyStatus}" FontWeight="Bold" />
                        <TextBlock Text="{Binding TechnologyDecisionView}" TextWrapping="Wrap" />
                        <ListBox ItemsSource="{Binding TechnologyDecisions}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0" />
                        <TextBlock Text="{DynamicResource TechnologyDescription}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Quality}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding QualitySummary}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource DefectPareto}" Margin="0,10,0,3" FontWeight="SemiBold" />
                        <ListBox ItemsSource="{Binding MainDefects}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Warnings}" Style="{StaticResource SectionTitle}" />
                        <DataGrid ItemsSource="{Binding WarningList}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="210" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource GridBorderBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Severity}" Width="85"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource WarningLevel}" Foreground="{DynamicResource GridHeaderTextBrush}" /></DataGridTextColumn.Header></DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Category}" Width="90"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource WarningCategory}" Foreground="{DynamicResource GridHeaderTextBrush}" /></DataGridTextColumn.Header></DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Message}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource WarningMessage}" Foreground="{DynamicResource GridHeaderTextBrush}" /></DataGridTextColumn.Header></DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Recommendations}" Style="{StaticResource SectionTitle}" />
                        <DataGrid ItemsSource="{Binding RecommendationList}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="210" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource GridBorderBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Component}" Width="75"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource RecommendationComponent}" Foreground="{DynamicResource GridHeaderTextBrush}" /></DataGridTextColumn.Header></DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding CurrentState}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource CurrentState}" Foreground="{DynamicResource GridHeaderTextBrush}" /></DataGridTextColumn.Header></DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Recommendation}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Recommendation}" Foreground="{DynamicResource GridHeaderTextBrush}" /></DataGridTextColumn.Header></DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Reason}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Reason}" Foreground="{DynamicResource GridHeaderTextBrush}" /></DataGridTextColumn.Header></DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource PreviewReport}" Style="{StaticResource SectionTitle}" />
                        <ListBox ItemsSource="{Binding PreviewItems}" Height="38" BorderThickness="0" />
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="Zoom +" Command="{Binding PreviewZoomInCommand}" Padding="6,2" />
                                <Button Content="Zoom -" Command="{Binding PreviewZoomOutCommand}" Padding="6,2" />
                                <Button Content="Reset View" Command="{Binding ResetPreviewViewCommand}" Padding="6,2" />
                            </StackPanel>
                            <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <TabControl Height="145"
                                    SelectedIndex="{Binding SelectedPreviewIndex, Mode=OneWay}"
                                    Background="{DynamicResource PreviewBackgroundBrush}"
                                    Foreground="{DynamicResource TextBrush}">
                            <TabItem Style="{StaticResource PreviewTabItemStyle}">
                                <TabItem.Header><TextBlock Text="{DynamicResource Original}" Foreground="{DynamicResource TabForegroundBrush}" /></TabItem.Header>
                                <Border Background="{DynamicResource PreviewBackgroundBrush}" Padding="6"><Image Source="{Binding OriginalPreviewImage}" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0.5"><Image.LayoutTransform><ScaleTransform ScaleX="{Binding PreviewZoom}" ScaleY="{Binding PreviewZoom}" /></Image.LayoutTransform></Image></Border>
                            </TabItem>
                            <TabItem Style="{StaticResource PreviewTabItemStyle}">
                                <TabItem.Header><TextBlock Text="{DynamicResource Corrected}" Foreground="{DynamicResource TabForegroundBrush}" /></TabItem.Header>
                                <Border Background="{DynamicResource PreviewBackgroundBrush}" Padding="6"><Image Source="{Binding CorrectedPreviewImage}" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0.5"><Image.LayoutTransform><ScaleTransform ScaleX="{Binding PreviewZoom}" ScaleY="{Binding PreviewZoom}" /></Image.LayoutTransform></Image></Border>
                            </TabItem>
                            <TabItem Style="{StaticResource PreviewTabItemStyle}">
                                <TabItem.Header><TextBlock Text="{DynamicResource Overlay}" Foreground="{DynamicResource TabForegroundBrush}" /></TabItem.Header>
                                <Border Background="{DynamicResource PreviewBackgroundBrush}" Padding="6"><Image Source="{Binding OverlayPreviewImage}" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0.5"><Image.LayoutTransform><ScaleTransform ScaleX="{Binding PreviewZoom}" ScaleY="{Binding PreviewZoom}" /></Image.LayoutTransform></Image></Border>
                            </TabItem>
                            <TabItem Style="{StaticResource PreviewTabItemStyle}">
                                <TabItem.Header><TextBlock Text="{DynamicResource Production}" Foreground="{DynamicResource TabForegroundBrush}" /></TabItem.Header>
                                <Border Background="{DynamicResource PreviewBackgroundBrush}" Padding="6"><Image Source="{Binding ProductionPreviewImage}" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0.5"><Image.LayoutTransform><ScaleTransform ScaleX="{Binding PreviewZoom}" ScaleY="{Binding PreviewZoom}" /></Image.LayoutTransform></Image></Border>
                            </TabItem>
                        </TabControl>
                        <TextBlock Text="{DynamicResource ReportFile}" Margin="0,12,0,4" />
                        <TextBlock Text="{Binding AnalysisResultView}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ReportStatus}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding ReportOutputPath, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GridBorderBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{DynamicResource ExportPdf}" Command="{Binding ExportPdfCommand}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}" />
                            <Button Content="{DynamicResource ExportHtml}" Command="{Binding ExportHtmlCommand}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}" />
                            <Button Content="{DynamicResource ExportCanva}" Command="{Binding ExportCanvaCommand}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>