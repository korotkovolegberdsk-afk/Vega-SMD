<Window x:Class="Vega.StencilUI.Views.StencilViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Vega.StencilUI.Controls"
        Title="Vega-SMD Stencil Viewer"
        Width="1400" Height="900" MinWidth="1000" MinHeight="700"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Padding="8" Margin="0,0,0,8" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource GridBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Original" Command="{Binding ShowOriginalCommand}" Margin="0,0,6,0" />
                <Button Grid.Column="1" Content="Corrected" Command="{Binding ShowCorrectedCommand}" Margin="0,0,6,0" />
                <Button Grid.Column="2" Content="Overlay" Command="{Binding ShowOverlayCommand}" Margin="0,0,6,0" />
                <Button Grid.Column="3" Content="Production" Command="{Binding ShowProductionCommand}" />
                <TextBlock Grid.Column="4" Text="{Binding ModeName}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <StackPanel Grid.Column="5" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Fit View" Command="{Binding FitViewCommand}" Margin="6,0,0,0" />
                    <Button Content="100%" Command="{Binding Zoom100Command}" Margin="6,0,0,0" />
                    <Button Content="500%" Command="{Binding Zoom500Command}" Margin="6,0,0,0" />
                    <Button Content="1000%" Command="{Binding Zoom1000Command}" Margin="6,0,0,0" />
                    <Button Content="Zoom -" Command="{Binding ZoomOutCommand}" Margin="6,0,0,0" />
                    <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" Margin="8,0" />
                    <Button Content="Zoom +" Command="{Binding ZoomInCommand}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="8" Margin="0,8,0,0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource GridBorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Production:" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox Content="Show Frame" IsChecked="{Binding ShowFrame}" Margin="0,0,12,0" />
                <CheckBox Content="Show Board" IsChecked="{Binding ShowBoard}" Margin="0,0,12,0" />
                <CheckBox Content="Show Apertures" IsChecked="{Binding ShowApertures}" Margin="0,0,28,0" />
                <Rectangle Width="14" Height="14" Fill="#5096FF" Stroke="{DynamicResource GridBorderBrush}" Margin="0,0,5,0" /><TextBlock Text="Board" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Rectangle Width="14" Height="14" Fill="#46CD82" Stroke="{DynamicResource GridBorderBrush}" Margin="0,0,5,0" /><TextBlock Text="Apertures" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Rectangle Width="14" Height="14" Fill="#F0B43C" Stroke="{DynamicResource GridBorderBrush}" Margin="0,0,5,0" /><TextBlock Text="Frame" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Height="220" Margin="0,8,0,0" Padding="8" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource GridBorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Aperture Table" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="Apply Table" Command="{Binding ApplyApertureTableCommand}" Margin="12,0,0,0" /></StackPanel>
                <DataGrid x:Name="ApertureTable" ItemsSource="{Binding ModifiedPasteLayer.Apertures}" SelectedItem="{Binding SelectedAperture, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ApertureId}" IsReadOnly="True" Width="70" />
                        <DataGridTextColumn Header="Shape" Binding="{Binding Shape, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        <DataGridTemplateColumn Header="Width" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Width, StringFormat={}{0:F3} mm}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Height" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Height, StringFormat={}{0:F3} mm}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="X" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding X, StringFormat={}{0:F3} mm}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Y" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Y, StringFormat={}{0:F3} mm}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Rotation" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Rotation, StringFormat={}{0:F3}°}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="Usage Count" Binding="{Binding UsageCount}" IsReadOnly="True" Width="95" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <DockPanel>
            <Border DockPanel.Dock="Right" Width="250" Margin="8,0,0,0" Padding="12" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource GridBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Group Edit" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <CheckBox Content="Edit Mode" IsChecked="{Binding EditMode}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding SelectedCount, StringFormat=Selected: {0}}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SelectionInfo}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="Width (mm)" />
                    <TextBox Text="{Binding SelectedWidth, StringFormat={}{0:F3}, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                    <TextBlock Text="Height (mm)" />
                    <TextBox Text="{Binding SelectedHeight, StringFormat={}{0:F3}, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                    <Button Content="Apply" Command="{Binding ApplyEditCommand}" />
                    <TextBlock Text="Ctrl+click adds or removes an aperture. Drag left-to-right selects inside; right-to-left selects intersecting apertures." TextWrapping="Wrap" Margin="0,14,0,0" Opacity="0.75" />
                </StackPanel>
            </Border>
            <Border x:Name="PreviewSurface" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource GridBorderBrush}" BorderThickness="1" ClipToBounds="True" Focusable="True"
                    MouseWheel="PreviewSurface_MouseWheel" MouseLeftButtonDown="PreviewSurface_MouseLeftButtonDown" MouseMove="PreviewSurface_MouseMove" MouseLeftButtonUp="PreviewSurface_MouseLeftButtonUp" KeyDown="PreviewSurface_KeyDown">
                <controls:StencilVectorSurface x:Name="PreviewCanvas" Document="{Binding Document}" ViewMode="{Binding ViewMode}" Zoom="{Binding Zoom}" OffsetX="{Binding OffsetX}" OffsetY="{Binding OffsetY}"
                                               ShowFrame="{Binding ShowFrame}" ShowBoard="{Binding ShowBoard}" ShowApertures="{Binding ShowApertures}"
                                               EditMode="{Binding EditMode}" SelectedPrimitives="{Binding SelectedPrimitives}" EditedWidth="{Binding SelectedWidth}" EditedHeight="{Binding SelectedHeight}" ApertureOverrides="{Binding ApertureOverrides}" />
            </Border>
        </DockPanel>
    </DockPanel>
</Window>