<Window x:Class="Vega.StencilUI.PackageImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Vega.StencilUI.ViewModels" Title="Import Packages" Width="1080" Height="720" MinWidth="850" MinHeight="600"><Window.DataContext><vm:PackageImportViewModel/></Window.DataContext><DockPanel Margin="14"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Package Import Wizard" FontSize="20" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,12,0,8"><Button Content="Select File" Click="SelectFile_Click"/><TextBlock Text="{Binding FileName}" Margin="12,4"/><TextBlock Text="{Binding RowCount,StringFormat=Rows: {0}}" Margin="12,4"/><ComboBox Width="160" Margin="12,0" ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" SelectionChanged="Sheet_SelectionChanged"/><ComboBox Width="120" Margin="8,0" SelectedValue="{Binding Unit}"><ComboBoxItem Content="mm"/><ComboBoxItem Content="inch"/></ComboBox><ComboBox Width="160" Margin="8,0" SelectedValue="{Binding Mode}"><ComboBoxItem Content="CreateOnly"/><ComboBoxItem Content="CreateAndUpdate"/></ComboBox><Button Content="Validate Preview" Margin="8,0" Click="Validate_Click"/></StackPanel><TextBlock Text="{Binding Message}"/></StackPanel><TabControl><TabItem Header="Column Mapping"><DataGrid ItemsSource="{Binding Mappings}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Source Column" Binding="{Binding SourceColumn}" IsReadOnly="True" Width="*"/><DataGridComboBoxColumn Header="Target Field" SelectedItemBinding="{Binding TargetField}" Width="*"><DataGridComboBoxColumn.ItemsSource><x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib"><sys:String></sys:String><sys:String>PackageName</sys:String><sys:String>StandardName</sys:String><sys:String>DisplayName</sys:String><sys:String>PackageFamily</sys:String><sys:String>ComponentType</sys:String><sys:String>Length</sys:String><sys:String>Width</sys:String><sys:String>Height</sys:String><sys:String>BodyLength</sys:String><sys:String>BodyWidth</sys:String><sys:String>LeadCount</sys:String><sys:String>PadCount</sys:String><sys:String>Pitch</sys:String><sys:String>LeadLength</sys:String><sys:String>LeadWidth</sys:String><sys:String>ThermalPadLength</sys:String><sys:String>ThermalPadWidth</sys:String><sys:String>BallDiameter</sys:String><sys:String>BallPitch</sys:String><sys:String>IPCName</sys:String><sys:String>JEDECName</sys:String><sys:String>YamahaName</sys:String><sys:String>MirtecAoiClass</sys:String><sys:String>Description</sys:String><sys:String>Notes</sys:String><sys:String>Aliases</sys:String></x:Array></DataGridComboBoxColumn.ItemsSource></DataGridComboBoxColumn></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Validation Preview"><DataGrid ItemsSource="{Binding Preview}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Status" Binding="{Binding Status}"/><DataGridTextColumn Header="Package" Binding="{Binding PackageName}"/><DataGridTextColumn Header="Family" Binding="{Binding PackageFamily}"/><DataGridTextColumn Header="Action" Binding="{Binding Action}"/><DataGridTextColumn Header="Message" Binding="{Binding Messages[0]}" Width="*"/></DataGrid.Columns></DataGrid></TabItem></TabControl><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Import" Width="100" Click="Import_Click"/><Button Content="Show Errors" Width="100" Margin="8,0" Click="ShowErrors_Click"/><Button Content="Close" Width="100" Click="Close_Click"/></StackPanel></DockPanel></Window>
