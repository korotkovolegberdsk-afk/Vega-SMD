<Window x:Class="Vega.StencilUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vega.StencilUI.ViewModels"
        Title="Vega-SMD Stencil Expert" Height="800" Width="1280" MinHeight="620" MinWidth="980"
        Background="#F4F7FB">
    <Window.DataContext>
        <vm:StencilWorkspaceViewModel />
    </Window.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Новый проект" Command="{Binding CreateProjectCommand}" />
                <MenuItem Header="Открыть проект" />
                <MenuItem Header="Сохранить проект" />
                <Separator />
                <MenuItem Header="Выход" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="Проект">
                <MenuItem Header="Входные данные" Command="{Binding LoadInputCommand}" />
                <MenuItem Header="Frame" />
            </MenuItem>
            <MenuItem Header="Инструменты">
                <MenuItem Header="Анализ трафарета" Command="{Binding AnalyzeCommand}" />
                <MenuItem Header="Проверка Gerber" Command="{Binding PreviewCommand}" />
            </MenuItem>
            <MenuItem Header="Справка"><MenuItem Header="О программе" /></MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" Background="#13233D" Padding="24,15">
            <TextBlock Text="Vega-SMD Stencil Expert" Foreground="White" FontSize="24" FontWeight="SemiBold" />
        </Border>
        <Grid Margin="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ПРОЕКТ" FontWeight="Bold" Foreground="#334155" Margin="4,0,0,8" />
                    <Border Background="White" Padding="16" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Проект" /><TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" />
                            <TextBlock Text="Источник данных" /><ComboBox ItemsSource="{Binding InputSources}" SelectedItem="{Binding InputSource}" Margin="0,3,0,10" />
                            <TextBlock Text="Входные файлы (через ; )" /><TextBox Text="{Binding InputFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" TextWrapping="Wrap" MinHeight="48" />
                            <TextBlock Text="Frame" /><ComboBox ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}" DisplayMemberPath="Name" Margin="0,3,0,10" />
                            <TextBlock Text="Paste Side" /><ComboBox ItemsSource="{Binding PasteSides}" SelectedItem="{Binding PasteSide}" Margin="0,3,0,10" />
                            <TextBlock Text="Workflow Status" /><Border Background="{Binding StatusColor}" CornerRadius="4" Padding="8,4" Margin="0,3,0,0"><TextBlock Text="{Binding WorkflowStatus}" Foreground="White" FontWeight="SemiBold" /></Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="УПРАВЛЕНИЕ" FontWeight="Bold" Foreground="#334155" Margin="4,18,0,8" />
                    <UniformGrid Columns="2">
                        <Button Content="Новый проект" Command="{Binding CreateProjectCommand}" Margin="3" Padding="8" />
                        <Button Content="Загрузить входные данные" Command="{Binding LoadInputCommand}" Margin="3" Padding="8" />
                        <Button Content="Анализ" Command="{Binding AnalyzeCommand}" Margin="3" Padding="8" />
                        <Button Content="Коррекция" Command="{Binding CorrectCommand}" Margin="3" Padding="8" />
                        <Button Content="Preview" Command="{Binding PreviewCommand}" Margin="3" Padding="8" />
                        <Button Content="Экспорт Gerber" Command="{Binding ExportCommand}" Margin="3" Padding="8" />
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="210" /><RowDefinition Height="16" /><RowDefinition Height="*" /><RowDefinition Height="16" /><RowDefinition Height="160" /></Grid.RowDefinitions>
                <Border Background="White" Padding="16" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="АНАЛИЗ" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10" /><TextBlock Text="Количество апертур" /><TextBlock Text="{Binding AnalysisResult.ApertureCount}" FontSize="22" /><TextBlock Text="Warnings" Margin="0,8,0,0" /><TextBlock Text="{Binding WarningCount}" FontSize="22" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="КОРРЕКЦИИ" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10" /><TextBlock Text="Изменено апертур" /><TextBlock Text="{Binding ModifiedApertures}" FontSize="22" /><TextBlock Text="WindowPane / HomePlate / Snubnose" Margin="0,8,0,0" /><TextBlock><Run Text="{Binding WindowPaneCount}" /><Run Text=" / " /><Run Text="{Binding HomePlateCount}" /><Run Text=" / " /><Run Text="{Binding SnubnoseCount}" /></TextBlock></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="ОШИБКИ" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10" /><TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" /></StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="White" Padding="16" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel><TextBlock Text="PREVIEW / OVERLAY" FontWeight="Bold" Foreground="#334155" DockPanel.Dock="Left" /><ComboBox ItemsSource="{Binding PreviewModes}" SelectedItem="{Binding PreviewMode}" Width="130" DockPanel.Dock="Right" /></DockPanel>
                        <Border Grid.Row="1" Background="#E8EEF7" BorderBrush="#B9C7DD" BorderThickness="1" Margin="0,12,0,0" CornerRadius="4">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Placeholder: Gerber Overlay Viewer" FontSize="18" Foreground="#475569" HorizontalAlignment="Center" /><TextBlock Text="{Binding VisiblePreviewLayers, StringFormat='Слои: {0}'}" Foreground="#64748B" Margin="0,8,0,0" HorizontalAlignment="Center" /></StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="4" Background="White" Padding="16" CornerRadius="6">
                    <DockPanel><StackPanel DockPanel.Dock="Right" Width="170"><Button Content="Открыть папку проекта" Command="{Binding OpenOutputFolderCommand}" Padding="8" /><TextBlock Text="Папка экспорта" Margin="0,10,0,0" /><TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" /></StackPanel><StackPanel><TextBlock Text="OUTPUT FILES" FontWeight="Bold" Foreground="#334155" /><ListBox ItemsSource="{Binding OutputFiles}" BorderThickness="0" Margin="0,8,16,0" /></StackPanel></DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>