<Window x:Class="Vega.StencilUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Vega.StencilUI.Views"
        xmlns:vm="clr-namespace:Vega.StencilUI.ViewModels"
        Title="Vega-SMD SMT Engineering Workspace"
        Height="900"
        Width="1440"
        MinHeight="700"
        MinWidth="1100">
    <Window.DataContext>
        <vm:EngineeringWorkspaceViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BitmapImage x:Key="VegaSmdLogo" UriSource="/Vega.StencilUI;component/Resources/Images/Vega-SMD-Logo.jpg" />
        <Style x:Key="ThemedMenuItem"
               TargetType="MenuItem"
               BasedOn="{StaticResource {x:Type MenuItem}}" />
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource MenuBackgroundBrush}"
              Foreground="{DynamicResource MenuForegroundBrush}">
            <MenuItem Header="{DynamicResource FileMenu}"
                      Style="{StaticResource ThemedMenuItem}">
                <MenuItem Header="{DynamicResource CreateProjectArchive}"
                          Style="{StaticResource ThemedMenuItem}"
                          Click="CreateProjectArchive_Click" />
                <MenuItem Header="{DynamicResource CreateProgramArchive}"
                          Style="{StaticResource ThemedMenuItem}"
                          Click="CreateProgramArchive_Click" />
            </MenuItem>
            <MenuItem Header="{DynamicResource ProjectMenu}"
                      Style="{StaticResource ThemedMenuItem}" />
            <MenuItem Header="{DynamicResource Tools}"
                      Style="{StaticResource ThemedMenuItem}">
                <MenuItem Header="{DynamicResource Settings}"
                          Style="{StaticResource ThemedMenuItem}"
                          Click="Settings_Click" />
                <Separator />
                <MenuItem Header="Библиотека корпусов и компонентов"
                          Style="{StaticResource ThemedMenuItem}"
                          Click="MasterLibrary_Click" />
            </MenuItem>
            <MenuItem Header="{DynamicResource HelpMenu}"
                      Style="{StaticResource ThemedMenuItem}" />
        </Menu>
        <views:EngineeringWorkspaceView />
    </DockPanel>
</Window>