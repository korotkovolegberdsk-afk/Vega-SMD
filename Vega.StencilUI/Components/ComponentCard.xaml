<UserControl x:Class="Vega.StencilUI.Components.ComponentCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Vega.StencilUI.Controls"
 xmlns:tape="clr-namespace:Vega.StencilUI.TapeReelDrawing"
 x:Name="Root" MinWidth="640" Background="#F5F7F9" FontFamily="Arial" FontSize="24" Foreground="#1B1F23"
 TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed">
 <UserControl.Resources>
  <Style TargetType="GroupBox">
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#AEBAC6"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="GroupBox">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="{TemplateBinding Header}" FontFamily="Arial" FontSize="28" FontWeight="Normal"
         Foreground="#1769C2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
       </Grid>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Arial"/><Setter Property="FontSize" Value="24"/><Setter Property="Foreground" Value="#1B1F23"/><Setter Property="Opacity" Value="1"/></Style>
 </UserControl.Resources>
 <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
  <Grid Width="1750" Height="1200" Background="#F5F7F9">
   <Grid Margin="20,19,20,39">
    <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#FFFFFF" BorderBrush="#AEBAC6" BorderThickness="1">
     <TextBlock Text="{Binding Package.PackageName, ElementName=Root, StringFormat={}{0} | КАРТОЧКА КОМПОНЕНТА}" Foreground="#1769C2" FontSize="28" Margin="26,0,0,0" VerticalAlignment="Center"/>
    </Border>
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="940"/><ColumnDefinition Width="40"/><ColumnDefinition Width="730"/></Grid.ColumnDefinitions>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="760"/><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <GroupBox Header="ЧЕРТЁЖ КОРПУСА" Padding="8,40,8,65">
       <controls:KiCadModelPreview Package="{Binding Package, ElementName=Root}" ModelPath="{Binding CadModel.ModelPath, ElementName=Root}" CadModel="{Binding CadModel, ElementName=Root}"/>
      </GroupBox>
      <GroupBox Grid.Row="2" Header="СПРАВОЧНЫЕ ДАННЫЕ КОМПОНЕНТА" Padding="32,0,24,18">
       <TextBlock Text="{Binding ReferenceDetails, ElementName=Root}" LineHeight="30" TextWrapping="Wrap"/>
      </GroupBox>
     </Grid>
     <Grid Grid.Column="2">
      <Grid.RowDefinitions><RowDefinition Height="505"/><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <GroupBox Header="АПЕРТУРЫ ТРАФАРЕТА" Padding="32,0,32,24">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="205"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <controls:StencilAperturePreview Package="{Binding Package, ElementName=Root}" Rule="{Binding StencilRule, ElementName=Root}" Footprint="{Binding Footprint, ElementName=Root}"/>
        <TextBlock Grid.Row="1" Margin="20,20,0,0" Text="{Binding ApertureDetails, ElementName=Root}"
                   LineHeight="30" TextWrapping="Wrap" VerticalAlignment="Top"/>
       </Grid>
      </GroupBox>
      <GroupBox Grid.Row="2" Header="ЛЕНТА И УПАКОВКА" Padding="0,0,0,12">
       <Grid>
        <tape:TapeReelPreview ShowTitle="False" Component="{Binding Component, ElementName=Root}" Package="{Binding Package, ElementName=Root}" Geometry="{Binding TapeProfile, ElementName=Root}"/>
        <TextBlock Text="Данные Tape &amp; Reel отсутствуют" Margin="24" VerticalAlignment="Center">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TapeProfile, ElementName=Root}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </Grid>
      </GroupBox>
     </Grid>
    </Grid>
   </Grid>
  </Grid>
 </Viewbox>
</UserControl>
