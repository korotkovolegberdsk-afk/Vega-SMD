<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GridBorderBrush}" />
        <Setter Property="RowBackground" Value="{DynamicResource GridBackgroundBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridBorderBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridBorderBrush}" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GridHeaderTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GridBorderBrush}" />
        <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GridBorderBrush}" />
        <Setter Property="Padding" Value="5,3" />
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
    </Style>
</ResourceDictionary>